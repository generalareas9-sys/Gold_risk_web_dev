# Copy this file to `.env` and override for your local machine.
# Real values must never be committed — `.env` is git-ignored.

# Environment to run as: development | test | production
NODE_ENV=development

# Port the GoldRisk API listens on.
PORT=3000

# Comma-separated list of origins that may call the API.
# The local React/Vite frontend (dev server) is http://localhost:5173.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string. Placeholder only — never commit real
# credentials. The database defaults to `goldrisk_dev` when the URL has no
# path segment.
# DATABASE_URL=postgres://goldrisk:CHANGE_ME@localhost:5432/goldrisk_dev

# Secret used to sign/verify access tokens. Required in production; generate
# with e.g. `openssl rand -hex 48`. NEVER commit a real value.
# JWT_SECRET=CHANGE_ME_use_a_long_random_hex_string

# How long access tokens stay valid (30s | 15m | 4h | 1d). Defaults to 15m.
JWT_EXPIRES_IN=15m

# -----------------------------------------------------------------------
# Google OAuth (Authorization Code flow)
#
# Create a Google Cloud project, OAuth 2.0 client, and consent screen
# before setting these values. Full setup steps are documented in
# ../GOOGLE_OAUTH.md.
# -----------------------------------------------------------------------

# Google Cloud OAuth 2.0 Client ID (public — safe to commit).
# GOOGLE_CLIENT_ID=

# Google Cloud OAuth 2.0 Client Secret (private — NEVER commit).
# GOOGLE_CLIENT_SECRET=

# Full URL Google redirects to after the user consents.
# Local development: http://localhost:3000/api/auth/google/callback
# Production:        https://goldrisk.onrender.com/api/auth/google/callback
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend origin — the backend redirects the browser here after a successful
# Google OAuth exchange. Must match the Google Cloud "Authorized origins"
# list if the frontend calls the API.
# Local development: http://localhost:5173
# Production:        https://goldrisk.vercel.app
# FRONTEND_URL=http://localhost:5173
