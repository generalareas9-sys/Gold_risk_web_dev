# Base URL for the GoldRisk API. Copy this file to .env.local and set the URL
# you want the frontend to talk to (no value intentionally, so a missing
# config fails loudly instead of silently calling the wrong backend).
#
# Local development:          http://localhost:3000/api
# Production:                 https://goldrisk.onrender.com/api
#
# Google OAuth needs no frontend variables: the login/register pages
# navigate to {VITE_API_BASE_URL}/auth/google, and the backend handles the
# Google consent + code exchange. See ../GOOGLE_OAUTH.md.
VITE_API_BASE_URL=http://localhost:3000/api